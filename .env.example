# Postgres (docker compose up -d)
DATABASE_URL="postgresql://jobdesk:jobdesk@localhost:5442/jobdesk?schema=public"

# Auth.js: generate with `openssl rand -base64 32`
AUTH_SECRET=""
# Public URL of the app (OAuth redirects, links in PDFs)
APP_URL="http://localhost:3210"

# Photo storage (phase 5). Leave empty until you create the apps.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
DROPBOX_APP_KEY=""
DROPBOX_APP_SECRET=""
# 32 bytes, base64: `openssl rand -base64 32`. Encrypts storage refresh tokens (AES-256-GCM).
TOKEN_ENCRYPTION_KEY=""

# Development only: store photos on local disk under .storage/ until Drive or Dropbox is
# connected. Never enable in production.
STORAGE_DEV_LOCAL="1"
